<!-- views/admin/carrers.ejs -->

<% layout("layouts/admin2") %>

<main class="main-content"> <div class="container-fluid">
<!-- PAGE HEADER -->
<h3 class="mb-4">
  <a href="/admin/pokemones">
    <i class="fa fa-paw me-2"></i>
    Pokedex
  </a>
  / Pokemones
</h3>


<div class="row">

  <!-- ========================= -->
  <!-- FORMULARIO -->
  <!-- ========================= -->
  <div class="col-lg-4 col-md-5 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0" id="cardTitle">
          <i class="fa fa-plus me-2"></i>
          Nueva Pokemon
        </h6>
      </div>

      <div class="card-body">

        <form method="POST" action="/pokemones">

          <div class="mb-3">

            <label for="name" class="form-label">
              Nombre
            </label>

            <input type="hidden" name="id" id="pokemonId">

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="Ingrese el nombre del pokemon"
              required
            >
          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Tipo
            </label>

            <input
              type="text"
              id="type"
              name="type"
              class="form-control"
              placeholder="Ingrese el tipo del pokemon"
              required
            >

          </div>


          <div class="d-flex justify-content-end gap-2">

            <button
              class="btn btn-outline-secondary"
              onclick="limpiar(event)"
            >
              <i class="fa fa-refresh me-1"></i>
              Limpiar
          </button>

            <button
              type="submit"
              class="btn btn-success"
              id="btnGuardar"
              onclick="agregar(event)"
            >
              <i class="fa fa-save me-1"></i>
              Guardar
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- LISTADO -->
  <!-- ========================= -->
  <div class="col-lg-8 col-md-7 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>
          Lista de Pokemones
        </h6>
      </div>


      <div class="card-body">

        <!-- HEADER ACTIONS -->
        <div class="d-flex justify-content-between align-items-center mb-3">

          <div class="text-muted">
            <i class="fa fa-graduation-cap me-1"></i>
            Pokemones registrados
          </div>

          <div>
            <a
              href="/pokemones/new"
              class="btn btn-success"
            >
              <i class="fa fa-plus"></i>
              Agregar Registro
            </a>
          </div>

        </div>


        <!-- TABLE -->
        <div class="table-responsive">

          <table class="table table-striped table-hover" id="pokemones">

            //cabesera de la tabla
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>


            <tbody>

              <% if (pokemones && pokemones.length > 0) { %>

                <% for (const pokemon of pokemones) { %>

                  <tr>

                    <td>
                      <%= pokemon.id %>
                    </td>

                    <td>
                      <%= pokemon.name %>
                    </td>

                    <td><%= pokemon.type %></td>

                    <td class="text-end">

                      <button
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="editar(<%= pokemon.id %>, event)"
                      >
                        <i class="fa fa-edit" ></i>
                        Editar
                    </button>

                      <button
                        class="btn btn-sm btn-outline-danger"
                        onclick="eliminar(<%= pokemon.id %>, event)"
                      >
                        <i class="fa fa-trash"></i>
                        Eliminar
                    </button>

                    </td>

                  </tr>

                <% } %>

              <% } else { %>

                <tr>
                  <td colspan="4" class="text-center text-muted py-4">
                    No se encontraron pokemones.
                  </td>
                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>

</div> </main>

<script>
    let carrerRows = document.getElementById("pokemones").children[1].children.length;

    function limpiar(event){
      event.preventDefault();
      document.getElementById("pokemonId").value="";
      document.getElementById("name").value="";
      document.getElementById("type").value="";
      document.getElementById("cardTitle").innerHTML = "Nuevo pokemon";
    }

    function agregar(event){
        event.preventDefault();

        let name = document.getElementById("name").value;
        let type = document.getElementById("type").value;
        let pokemonTable = document.getElementById("pokemones");
        let carrerId = document.getElementById("carrerId").value;

        if(pokemonId==""){
          let tr = document.createElement("TR");
          let td1 = document.createElement("TD");
          let td2 = document.createElement("TD");
          let td3 = document.createElement("TD");
          let td4 = document.createElement("TD");

          pokemonRows = pokemonRows + 1;
          td1.innerHTML = pokemonRows;
          td2.innerHTML = name;
          td3.innerHTML = type;

          tr.appendChild(td1);
          tr.appendChild(td2);
          tr.appendChild(td3);
          tr.appendChild(td4);

          console.log(tr);

          pokemonTable.children[1].appendChild(tr);
        }else{
          let tbody = pokemonTable.children[1];

          for (let tr of tbody.children) {
            console.log("1 ++++++++++++++++++++")
            console.log(typeof tr.children[0].innerHTML.trim())
            console.log(typeof carrerId)
            if(tr.children[0].innerHTML.trim() == pokemonId){
              tr.children[1].innerHTML = name;
              tr.children[2].innerHTML = type;
              document.getElementById("pokemonId").value="";
              document.getElementById("name").value="";
              document.getElementById("type").value="";
              document.getElementById("cardTitle").innerHTML = "Nuevo pokemon";
            }
          }
        }
    }

    function eliminar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        tr.remove();
    }

    function editar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        let idRow = tr.children[0].innerHTML;
        let name = tr.children[1].innerHTML;
        let type = tr.children[2].innerHTML;

        document.getElementById("cardTitle").innerHTML = "Editar pokemon";

        document.getElementById("name").value = name.trim();
        document.getElementById("type").value = type.trim();
        document.getElementById("pokemonId").value = id;
    }
</script>